---
import { url } from '../lib/utils'
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Button from '../components/Button.astro'
import WorkCard from '../components/WorkCard.astro'
import ServiceTile from '../components/ServiceTile.astro'
import Hero from '../components/Hero.astro'

---

<Layout>
  <Header />
  <main style="min-height:100vh; background:var(--porcelain); color:var(--ink); font-family: 'Instrument Sans', sans-serif; font-weight:400;">
    <Hero />

    <section style="max-width:1100px; margin:0 auto; padding:0 32px 160px;">
      <div style="font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--graphite); line-height:1.8; border-top:0.5px solid rgba(107,107,102,0.3); padding-top:20px; max-width:640px;">Now: enterprise clients in pharma and global finance, via Cognizant. Before: Hostinger, Juvare.</div>
      <h2 style="font-size:clamp(27px,4.5vw,34px); font-weight:500; letter-spacing:-0.02em; margin:72px 0 0;">Some of it I can show</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(270px,1fr)); gap:28px; margin-top:44px;">
        <WorkCard title="A billing flow two million people stopped noticing" subtitle="Redesigned the full billing experience and seven core pages. Good billing UX is invisible. That was the goal." meta="Hostinger · Product designer" shot="SHOT: billing flow UI" />
        <WorkCard title="Design for someone's worst day" subtitle="A shared design system across seven emergency response products. When the user is a crisis coordinator, clarity is not a nice to have." meta="Juvare · Product designer" shot="SHOT: design system" />
        <WorkCard title="Conversion design under regulation" subtitle="Regional website redesigns and Figma UI kits, shipped through medical, legal, and regulatory review. Constraints included." meta="Novo Nordisk · via Cognizant" shot="SHOT: regional website" />
      </div>

      <div style="margin-top:clamp(80px,11vw,130px); border-top:0.5px solid rgba(107,107,102,0.3); padding-top:64px;">
        <h2 style="font-size:clamp(27px,4.5vw,34px); font-weight:500; letter-spacing:-0.02em; margin:0;">Where you come in</h2>
        <p style="font-size:17px; line-height:1.65; color:var(--ink); max-width:560px; margin:20px 0 0;">Every engagement starts with the same question: what number are we trying to move?</p>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(270px,1fr)); gap:28px; margin-top:44px;">
          <ServiceTile name="Template" price="from €50" desc="Buy a conversion-ready landing page system and launch this week." />
          <ServiceTile name="CRO audit" price="€500" desc="Two weeks. I tear down your page, show you where it leaks, and hand you a prioritized fix list." />
          <ServiceTile name="Design sprint" price="from €1000" desc="We redesign the page together and ship it." />
        </div>
        <a href={url('/Services/')} style="display:inline-block; margin-top:36px; color:var(--indigo); text-decoration:none; font-size:15px; font-weight:500;">See services and products →</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

