---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

---

<Layout>
  <Header />
  <main style="min-height:100vh; background:var(--porcelain); color:var(--ink); font-family:'Instrument Sans', sans-serif;">
    <section style="max-width:960px; margin:0 auto; padding:clamp(80px,10vw,140px) 24px;">
      <div style="font-family:'JetBrains Mono', monospace; font-size:12px; color:var(--graphite);">Services</div>
      <h1 style="font-size:clamp(34px,6.5vw,48px); font-weight:500; margin:24px 0 0;">What I help companies ship</h1>
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px,1fr)); gap:20px; margin-top:28px;">
        <div style="background:var(--porcelain); padding:18px; border-radius:8px; border:1px solid rgba(107,107,102,0.08);">
          <div style="font-weight:600; margin-bottom:8px;">Design systems</div>
          <div style="color:var(--graphite);">Create shared components, tokens, and documentation for consistent product delivery.</div>
        </div>
        <div style="background:var(--porcelain); padding:18px; border-radius:8px; border:1px solid rgba(107,107,102,0.08);">
          <div style="font-weight:600; margin-bottom:8px;">Conversion design</div>
          <div style="color:var(--graphite);">Landing pages, funnels, and experimentation focused on measurable outcomes.</div>
        </div>
        <div style="background:var(--porcelain); padding:18px; border-radius:8px; border:1px solid rgba(107,107,102,0.08);">
          <div style="font-weight:600; margin-bottom:8px;">Product strategy</div>
          <div style="color:var(--graphite);">Product thinking that connects UX, engineering, and business goals.</div>
        </div>
      </div>

      <div style="margin-top:36px;"><a href="/index.html#say-hello" style="display:inline-block; background:var(--indigo); color:var(--porcelain); padding:13px 26px; border-radius:8px; text-decoration:none;">Work with me</a></div>
    </section>
  </main>
  <Footer />
</Layout>
