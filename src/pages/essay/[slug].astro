---
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import essays from '../../data/essays.json'

export async function getStaticPaths() {
  return essays.order.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = essays[slug];
---

<Layout>
  <Header />
  <main style="min-height:100vh; background:var(--porcelain); color:var(--ink); font-family:'Newsreader', serif;">
    <section style="max-width:640px; margin:0 auto; padding:clamp(90px,12vw,150px) 24px;">
      <a href="/Journal" style="color:var(--indigo); text-decoration:none;">← Journal</a>
      <div style="font-family:'JetBrains Mono', monospace; font-size:12px; color:var(--graphite); margin-top:48px;">{post.date} · {post.readingTime}</div>
      <h1 style="font-style:italic; font-weight:500; font-size:clamp(34px,6.5vw,48px); margin:24px 0 0;">{post.title}</h1>

      <div style="margin-top:48px; display:flex; flex-direction:column; gap:28px;">
        {post.body.map(p => (
          p.startsWith('> ') ? (
            <blockquote style="font-family:'Newsreader', serif; font-style:italic; font-size:clamp(24px,4vw,29px); line-height:1.45; margin:24px 0;">{p.slice(2)}</blockquote>
          ) : (
            <p style="font-family:'Newsreader', serif; font-size:19px; line-height:1.75; margin:0;">{p}</p>
          )
        ))}
      </div>

      <div style="border-top:0.5px solid rgba(107,107,102,0.3); margin-top:70px; padding:48px 0 90px;">
        <a href="/Journal" style="color:var(--indigo); text-decoration:none; font-size:16px; font-weight:500;">More from the journal →</a>
        <div style="margin-top:24px;"><a href="/index.html#say-hello" style="display:inline-block; background:var(--indigo); color:var(--porcelain); padding:13px 26px; border-radius:8px; text-decoration:none;">Say hello</a></div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
