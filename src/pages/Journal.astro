---
import { url } from '../lib/utils'
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import essays from '../data/essays.json'

---

<Layout>
  <Header />
  <main style="min-height:100vh; background:var(--porcelain); color:var(--ink); font-family:'Instrument Sans', sans-serif;">
    <section style="max-width:1100px; margin:0 auto; padding:clamp(80px,10vw,140px) 32px;">
      <div style="font-family:'JetBrains Mono', monospace; font-size:12px; color:var(--graphite);">Journal</div>
      <h1 style="font-family:'Newsreader', serif; font-style:italic; font-weight:500; font-size:clamp(34px,6.5vw,48px); margin:24px 0 0;">Thinking in public</h1>
      <p style="font-family:'Newsreader', serif; font-style:italic; max-width:760px; color:var(--ink); margin-top:20px;">What I cannot show, I can think about out loud. Essays on design under constraint, craft in the age of generated everything, and the patterns that travel between industries.</p>

      <div style="margin-top:40px; display:flex; flex-direction:column; gap:18px;">
        {essays.order.map(slug => {
          const e = essays[slug];
          return (
            <a href={url(`/essay/${slug}/`)} style="font-family:'Newsreader', serif; font-style:italic; font-weight:500; font-size:24px; color:var(--ink); text-decoration:none; padding:18px 0; border-bottom:0.5px solid rgba(107,107,102,0.18);">{e.title}<div style="font-family:'Instrument Sans', sans-serif; font-size:14px; color:var(--graphite);">{e.summary}</div></a>
          )
        })}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
