---
export interface Props { title: string; subtitle: string; meta: string; shot?: string; href?: string }
const { title, subtitle, meta, shot = 'SHOT', href = '/Work.dc.html' } = Astro.props as Props;
---

<a href={href} style="display:block; text-decoration:none; color:var(--ink); border:0.5px solid rgba(107,107,102,0.3); border-radius:8px; background:var(--porcelain); overflow:hidden; transition:transform 300ms cubic-bezier(0.2,0.8,0.2,1), border-color 300ms;">
  <div style="height:190px; background:#F1F1ED; display:flex; align-items:center; justify-content:center;"> <span style="font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--graphite);">{shot}</span> </div>
  <div style="padding:24px; display:flex; flex-direction:column; gap:12px;">
    <h3 style="font-size:19px; font-weight:500; margin:0;">{title}</h3>
    <p style="font-size:14px; color:var(--graphite); margin:0;">{subtitle}</p>
    <div style="font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--graphite); margin-top:4px;">{meta}</div>
  </div>
</a>
