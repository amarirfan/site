---
import { url } from '../lib/utils'
const links = [
  { href: url('/Work/'), label: 'work' },
  { href: url('/Services/'), label: 'services' },
  { href: url('/Journal/'), label: 'journal' },
  { href: url('/About/'), label: 'about' },
  { href: url('/Craft/'), label: 'craft' }
];
---

<header style="position: sticky; top: 0; z-index:60; background: var(--bg-transparent); border-bottom: 0.5px solid var(--border); transition: background 300ms ease, border-color 300ms ease;">
  <nav style="max-width:1100px; margin:0 auto; padding:18px 32px; display:flex; align-items:center; justify-content:space-between;">
    <a href={url('/')} style="display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--ink);">
      <span style="display:flex; align-items:center; justify-content:center; width:22px; height:22px; background:#C7361F; border-radius:4px; font-family: 'Newsreader', serif; font-style:italic; font-size:15px; color: #FAFAF8; line-height:1;">a</span>
      <span style="font-weight:500; font-size:17px; letter-spacing:-0.02em;">ammar</span>
    </a>
    <div class="nav-links" style="display:flex; gap:36px; font-size:15px;">
      {links.map(link => (
        <a href={link.href} style="color: var(--indigo); text-decoration:none; font-weight:500; transition: opacity 250ms;">{link.label}</a>
      ))}
    </div>
    <button id="nav-toggle" aria-label="menu" style="display:none; width:44px; height:44px; background:none; border:none; cursor:pointer; padding:0;">
      <span id="bar1" style="display:block; width:20px; height:1.5px; background:var(--ink); margin:9px 12px;"></span>
      <span id="bar2" style="display:block; width:20px; height:1.5px; background:var(--ink); margin:9px 12px;"></span>
    </button>
    <div id="mobile-menu" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(250,250,248,0.95); backdrop-filter:blur(20px); padding:80px 32px; box-sizing:border-box;">
      <div style="display:flex; flex-direction:column; gap:12px;">
        {links.map(link => (
          <a href={link.href} style="color:var(--ink); font-size:34px; text-decoration:none; font-weight:500;">{link.label}</a>
        ))}
      </div>
    </div>
  </nav>
</header>
<script>
  // Basic mobile menu toggle and sticky background handling
  (function(){
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-menu');
    const bar1 = document.getElementById('bar1');
    const bar2 = document.getElementById('bar2');

    function showToggleIfNeeded(){
      if (window.innerWidth < 800){
        toggle.style.display = 'block';
        document.querySelector('.nav-links').style.display = 'none';
      } else {
        toggle.style.display = 'none';
        document.querySelector('.nav-links').style.display = 'flex';
        menu.style.display = 'none';
      }
    }

    window.addEventListener('resize', showToggleIfNeeded);
    showToggleIfNeeded();

    toggle.addEventListener('click', function(){
      const open = menu.style.display === 'block';
      if (open){
        closeMenu();
      } else {
        openMenu();
      }
    });

    function openMenu(){
      menu.style.display = 'block';
      toggle.setAttribute('aria-expanded', 'true');
      bar1.style.transform = 'translateY(8px) rotate(45deg)';
      bar2.style.transform = 'translateY(-8px) rotate(-45deg)';
      // focus first link
      const first = menu.querySelector('a');
      if (first) first.focus();
      // trap focus
      document.addEventListener('focus', trapFocus, true);
    }

    function closeMenu(){
      menu.style.display = 'none';
      toggle.setAttribute('aria-expanded', 'false');
      bar1.style.transform = 'none';
      bar2.style.transform = 'none';
      toggle.focus();
      document.removeEventListener('focus', trapFocus, true);
    }

    // Sticky glass effect on scroll and keyboard handling for menu
    const header = document.querySelector('header');
    function onScroll(){
      if (window.scrollY > 12) header.classList.add('nav-sticky');
      else header.classList.remove('nav-sticky');
    }
    // Respect reduced motion preference: don't toggle if user prefers reduced motion
    const prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReduced) {
      window.addEventListener('scroll', onScroll);
      onScroll();
    } else {
      // If reduced-motion, ensure header is in a simple non-animated state when scrolled
      window.addEventListener('scroll', function(){ if (window.scrollY > 12) header.classList.add('nav-sticky'); else header.classList.remove('nav-sticky'); });
    }
    // Close on escape
    window.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeMenu(); });

    // focus trap implementation
    function trapFocus(e){
      if (!menu.contains(e.target) && menu.style.display === 'block'){
        e.stopPropagation();
        menu.querySelector('a')?.focus();
      }
    }
  })();
</script>
